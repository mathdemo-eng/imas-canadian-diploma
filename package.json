{
  "name": "imas-canadian-diploma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "IMAS International School — Canadian (New Brunswick) High School Diploma website",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/prerender.tsx && node scripts/prerender.mjs",
    "build:artifact": "vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:sql": "tsx scripts/gen-seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "4.1.18",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
